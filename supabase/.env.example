# Supabase Auth (GoTrue) settings read by supabase/config.toml through env() (B0.7).
# Copy to supabase/.env for the local stack; the hosted project gets the same values
# (docs/runbooks/auth-config.md). Restart the stack after a change: supabase stop && supabase start.

AUTH_SITE_URL=http://localhost:3000
AUTH_JWT_EXPIRY_SECONDS=3600
AUTH_REFRESH_TOKEN_REUSE_INTERVAL_SECONDS=10

# Password policy (D-26): 12 characters; no composition rules (literal "" in config.toml)
AUTH_PASSWORD_MIN_LENGTH=12

# Email: minimum gap between two emails to one address; link/OTP lifetime (AC-38)
AUTH_EMAIL_MAX_FREQUENCY=1m0s
AUTH_EMAIL_OTP_EXPIRY_SECONDS=3600

# Sessions: forced sign-out after the timebox, or after inactivity
AUTH_SESSION_TIMEBOX=24h
AUTH_SESSION_INACTIVITY_TIMEOUT=8h

# GoTrue rate limits (per IP, 5-minute windows, except emails per hour)
AUTH_RATE_LIMIT_EMAIL_SENT=60
AUTH_RATE_LIMIT_TOKEN_REFRESH=150
AUTH_RATE_LIMIT_SIGN_IN_SIGN_UPS=30
AUTH_RATE_LIMIT_TOKEN_VERIFICATIONS=30

# SMTP for the hosted project ([auth.email.smtp] stays disabled locally -> Mailpit)
AUTH_SMTP_HOST=
AUTH_SMTP_USER=
AUTH_SMTP_PASS=
AUTH_SMTP_ADMIN_EMAIL=no-reply@bookvault.local
AUTH_SMTP_SENDER_NAME=BookVault
