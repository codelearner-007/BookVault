# Database: FastAPI connects as bookvault_api (no SUPERUSER/BYPASSRLS, RLS applies; B0.4).
# The password below is a LOCAL DEFAULT only; set the role password from env with
# scripts/set_api_role_password.sh, and use a generated secret outside local dev.
DATABASE_URL=postgresql://bookvault_api:bookvault-api-local-dev@127.0.0.1:55342/postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Supabase
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# JWT Configuration
USE_JWKS=true

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS (optional, disabled by default for Vercel rewrites)
# Only enable for direct API access testing (not needed for production)
ENABLE_CORS=false
ALLOWED_ORIGINS=["http://localhost:3000"]
